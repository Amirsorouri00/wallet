APP_NAME="Taline Wallet Ledger"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
GATEWAY_SECRET=development-gateway-secret

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=taline_wallet_ledger
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_TIMEZONE=UTC
DB_APPLICATION_NAME=taline-wallet-ledger
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=3000

WALLET_CLEARING_POOL_SIZE=64
WALLET_WITHDRAWAL_SUSPENSE_POOL_SIZE=16
WALLET_HISTORY_PAGE_SIZE=25
WALLET_HISTORY_PAGE_SIZE_MAX=100
WALLET_DEADLOCK_RETRIES=3
WALLET_READINESS_MAX_OUTBOX_LAG_SECONDS=60
WALLET_RATE_LIMIT_WRITES_PER_MINUTE=6000
WALLET_RATE_LIMIT_GATEWAY_PER_MINUTE=12000
WALLET_RATE_LIMIT_ADMIN_PER_MINUTE=6000
WALLET_RATE_LIMIT_READS_PER_MINUTE=60000
WALLET_OUTBOX_BATCH_SIZE=100
WALLET_OUTBOX_LEASE_SECONDS=30
WALLET_OUTBOX_BASE_BACKOFF_SECONDS=2
WALLET_OUTBOX_MAX_BACKOFF_SECONDS=300
WALLET_OUTBOX_MAX_ATTEMPTS=10

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
